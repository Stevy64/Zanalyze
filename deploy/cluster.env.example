# Modèle du Secret du namespace zanalyze.
# Sur le VPS : /etc/zanalyze/app.env, mode 600. Ne pas commiter le fichier rempli.
# Générer la clé : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Le site public est zanalyze.gabomazone.com.
# localhost et 127.0.0.1 servent aux sondes du pod. L'Ingress n'envoie que le nom public.
# Postgres est celui du namespace donnees (un seul pour tout le VPS).
# Zanalyze lit l'utilisateur, le mot de passe, l'hôte et le nom dans DJANGO_DB_URL.
# Le paramètre sslmode de l'URL est ignoré : le Service Postgres n'est pas publié.

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-secrets.token_urlsafe-48
DJANGO_ALLOWED_HOSTS=zanalyze.gabomazone.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://zanalyze.gabomazone.com
DJANGO_SSL=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_URL=postgresql://zanalyze:MOT@postgres.donnees.svc.cluster.local:5432/zanalyze
ZANALYZ_REDIS_URL=redis://redis:6379/0
ZANALYZ_MOTEUR_URL=http://moteur:8001
ZANALYZ_SYNC_LIVE=1
ZANALYZ_WORKER_INTERVAL=7200
ZANALYZ_SYNC_PAGES=1
ZANALYZ_SYNC_PASSES=1
ZANALYZ_SYNC_CONTEXTE=0
ENGINE_CALIBRATION_FILE=/app/data/engine-calibration.json

# SingPay, seulement avec les identifiants du portefeuille Zanalyze.
# ZANALYZ_SINGPAY_CLIENT_ID=
# ZANALYZ_SINGPAY_CLIENT_SECRET=
# ZANALYZ_SINGPAY_WALLET=
# ZANALYZ_SINGPAY_DISTRIBUTION=
# ZANALYZ_WHATSAPP_PHONE=
# ANDROID_APP_URL=#
# IOS_APP_URL=#

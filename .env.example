# Copie vers .env à la racine du projet (ne pas committer .env).
# cp .env.example .env && nano .env
#
# Local Docker :  make dev
# Prod Docker   :  make prod   (OVH / VPS)
# PythonAnywhere : pas de Docker — voir docs/pythonanywhere.md

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-moi-avec-une-cle-longue-aleatoire
DJANGO_ALLOWED_HOSTS=zanalyz.example.com,www.zanalyz.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://zanalyz.example.com,https://www.zanalyz.example.com
DJANGO_SSL=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# SQLite (défaut local / make dev) :
# DJANGO_SQLITE_PATH=/app/data/db.sqlite3

# PostgreSQL (make prod / docker-compose.yml) :
POSTGRES_DB=zanalyz
POSTGRES_USER=zanalyz
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
# DJANGO_DB_URL est injecté automatiquement par docker-compose.yml

# Ports Docker
ZANALYZ_DEV_PORT=8000
ZANALYZ_MOTEUR_PORT=8001
ZANALYZ_HTTP_PORT=80
GUNICORN_WORKERS=3

# Micro-services
ZANALYZ_MOTEUR_URL=http://moteur:8001
ZANALYZ_REDIS_URL=redis://redis:6379/0
ZANALYZ_WORKER_INTERVAL=7200
ZANALYZ_SYNC_PAGES=1
ZANALYZ_SYNC_PASSES=1
ZANALYZ_SYNC_CONTEXTE=0
# 1 = SofaScore depuis Django (VPS). 0 = snapshot Zanalyze Engine (PythonAnywhere).
ZANALYZ_SYNC_LIVE=1
# ZANALYZ_SNAPSHOT_URL=https://raw.githubusercontent.com/Stevy64/Zanalyze-Engine/main/exports/matchs.json
# ZANALYZ_SNAPSHOT_PATH=exports/matchs.json

# WhatsApp VIP (fallback si Réglages site admin vide)
# ZANALYZ_WHATSAPP_PHONE=33612345678

# Liens boutons telechargement app. Hors http(s) => popup Bientot disponible + PWA.
ANDROID_APP_URL=#
IOS_APP_URL=#
